// Home — a small household hub, one module per household task.
//
// ## Grocery module
// Mirrors the master data exported from "Grocery database.xlsx":
//   Grocery    -> Item.nameTa   (Tamil name)
//   Grocery.1  -> Item.nameEn   (English name)
//   (added)    -> Item.nameTl   (Tanglish — the Tamil name in Latin script)
//   Type       -> Category      (e.g. பருப்பு வகை / Dals)
//   Qty Type   -> Item.unitType (kg, g, L, ml, Rs, or blank = countable)
//   From       -> Shop          (e.g. D Mart, Balamurugan, Jio Mart)
//
// ## Petrol Card module
// FuelEntry logs one refuel (vehicle, amount, when, where); FuelBudget is a
// single adjustable monthly spending limit compared against the current
// month's FuelEntry total.
//
// ## Family Tree module
// Imported from "Family_tree.xlsx" (a PowerPoint/Excel SmartArt org chart
// used as a genealogy diagram — see prisma/import-family-tree.ts for how
// its shapes were extracted). FamilyMember is one person; FamilyRelationship
// is a directed edge between two members, either PARENT_OF (parent -> child,
// a child can have more than one) or SPOUSE_OF. Members and edges can both
// be added from the UI to expand the tree beyond the imported data.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

/// Unit of measure for an item. Drives the +/- stepper increments in the UI.
///   G, ML  -> step 50
///   KG, L  -> step 0.5
///   RS     -> step 10
///   COUNT  -> step 1 (blank "Qty Type" in the spreadsheet)
enum UnitType {
  KG
  G
  L
  ML
  RS
  COUNT
}

enum ListStatus {
  DRAFT
  FINALIZED
  COMPLETED
}

/// "Type" column — e.g. பருப்பு வகை / Dals
model Category {
  id        Int      @id @default(autoincrement())
  nameTa    String?
  nameEn    String   @unique
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  items Item[]

  @@index([sortOrder])
}

/// "From" column — the shop an item is normally bought from.
model Shop {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  items          Item[]
  groceryItems   GroceryListItem[]
  priceHistories PriceHistory[]
}

/// A master-data grocery item.
model Item {
  id         Int       @id @default(autoincrement())
  nameTa     String
  nameEn     String
  /// "Tanglish" — the Tamil name written in Latin script
  /// (கடலை பருப்பு -> "Kadalai Paruppu"). Optional: null means nobody has
  /// supplied one yet, and the UI falls back to the Tamil name. Kept
  /// separate from nameEn because the English name is a *translation*
  /// ("Bengal gram"), not something you can read out loud at the shop.
  nameTl     String?
  unitType   UnitType  @default(COUNT)
  /// Quantity pre-filled when the item is added to a list.
  defaultQty Decimal   @default(1) @db.Decimal(10, 2)
  categoryId Int
  /// Default shop ("From"); can be overridden per list item.
  shopId     Int?
  isActive   Boolean   @default(true)
  /// Pack size — what one of this item comes in: a 200 g tube of paste, a
  /// 500 ml bottle of dish wash. Null for anything sold loose, where the
  /// quantity is already the measure (2 kg of dal). Only countable items
  /// carry one: `defaultQty` then counts packs and the size says how big
  /// each pack is, which is the part that changes at the shop when the
  /// store only stocks 150 g.
  sizeValue  Decimal?  @db.Decimal(10, 2)
  sizeUnit   UnitType?
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  category       Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  shop           Shop?             @relation(fields: [shopId], references: [id], onDelete: SetNull)
  listItems      GroceryListItem[]
  priceHistories PriceHistory[]

  @@unique([nameEn, categoryId])
  @@index([nameTa])
  @@index([categoryId])
  @@index([shopId])
}

/// A monthly list, e.g. "Jul 2026".
model GroceryList {
  id          Int        @id @default(autoincrement())
  name        String
  /// Sortable month key, "YYYY-MM". Several lists can share a month as
  /// long as their names differ.
  monthKey    String
  status      ListStatus @default(DRAFT)
  finalizedAt DateTime?
  completedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  items          GroceryListItem[]
  priceHistories PriceHistory[]

  @@unique([monthKey, name])
  @@index([monthKey])
}

/// One row of a monthly list.
model GroceryListItem {
  id        Int       @id @default(autoincrement())
  listId    Int
  itemId    Int
  quantity  Decimal   @db.Decimal(10, 2)
  /// Snapshot of the item's unit at the time it was added.
  unitType  UnitType
  /// Snapshot of the item's pack size, and the one field shopping is meant
  /// to change: the list says 200 g, the shop only has 150 g, so the row is
  /// re-sized before the price is recorded. Null for items sold loose.
  sizeValue Decimal?  @db.Decimal(10, 2)
  sizeUnit  UnitType?
  /// Shop this row must be bought from (overrides Item.shopId).
  shopId    Int?

  isPurchased       Boolean   @default(false)
  /// Price actually paid, entered while shopping.
  purchasePrice     Decimal?  @db.Decimal(10, 2)
  /// Snapshot of the previous month's price, kept for the up/down indicator.
  previousPrice     Decimal?  @db.Decimal(10, 2)
  /// Snapshot of the quantity/unit that previousPrice was paid for — needed
  /// to compare fairly when a variable-unit item's size changes between
  /// purchases (e.g. 150g this month vs. 200g last month).
  previousQuantity  Decimal?  @db.Decimal(10, 2)
  previousUnitType  UnitType?
  /// ...and of the pack size it was paid for, since that is where a
  /// packaged item's amount actually lives (1 × 200 g, then 1 × 150 g).
  previousSizeValue Decimal?  @db.Decimal(10, 2)
  previousSizeUnit  UnitType?
  purchasedAt       DateTime?

  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  list GroceryList @relation(fields: [listId], references: [id], onDelete: Cascade)
  item Item        @relation(fields: [itemId], references: [id], onDelete: Restrict)
  shop Shop?       @relation(fields: [shopId], references: [id], onDelete: SetNull)

  @@unique([listId, itemId, shopId])
  @@index([listId, shopId])
  @@index([itemId])
}

/// Append-only record of what an item actually cost, used for
/// "cheaper / dearer than last month" comparisons.
model PriceHistory {
  id          Int       @id @default(autoincrement())
  itemId      Int
  listId      Int?
  shopId      Int?
  price       Decimal   @db.Decimal(10, 2)
  quantity    Decimal   @db.Decimal(10, 2)
  unitType    UnitType
  /// Pack size the price was paid for — "₹95 for 1 × 200 g". Null for
  /// items sold loose.
  sizeValue   Decimal?  @db.Decimal(10, 2)
  sizeUnit    UnitType?
  purchasedAt DateTime  @default(now())

  item Item         @relation(fields: [itemId], references: [id], onDelete: Cascade)
  /// Deleting a list deletes what was recorded on it. Detaching the rows
  /// instead (SetNull) left them in the item's price history with no month
  /// against them and no screen able to reach them, while they still quoted
  /// a price and still counted as "last time" — so a list deleted after a
  /// trial run kept steering real shopping. listId stays optional for the
  /// rows already orphaned that way; `npm run db:audit-prices` lists them.
  list GroceryList? @relation(fields: [listId], references: [id], onDelete: Cascade)
  shop Shop?        @relation(fields: [shopId], references: [id], onDelete: SetNull)

  @@index([itemId, purchasedAt])
  @@index([listId])
}

// ---------------------------------------------------------------------------
// Petrol Card module
// ---------------------------------------------------------------------------

enum VehicleType {
  TWO_WHEELER
  CAR
}

/// A household vehicle. Kept as real rows (rather than a fixed enum) so
/// vehicles can be added and their details edited over time.
model Vehicle {
  id                 Int         @id @default(autoincrement())
  name               String      @db.VarChar(191)
  type               VehicleType
  registrationNumber String?     @db.VarChar(32)
  insuranceRenewal   DateTime?   @db.Date
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  fuelEntries FuelEntry[]
}

/// One refuel: how much, which vehicle, when, and (if the browser allowed
/// it) where — captured automatically via the Geolocation API.
model FuelEntry {
  id            Int      @id @default(autoincrement())
  vehicleId     Int
  amount        Decimal  @db.Decimal(10, 2)
  refueledAt    DateTime
  latitude      Decimal? @db.Decimal(9, 6)
  longitude     Decimal? @db.Decimal(9, 6)
  /// A short human-readable area name resolved from lat/lng client-side (e.g. "Indiranagar, Bengaluru").
  locationLabel String?  @db.VarChar(191)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])

  @@index([refueledAt])
  @@index([vehicleId])
}

/// A single adjustable monthly spending limit — not one row per month, just
/// whatever's currently set, compared against the current month's spend.
model FuelBudget {
  id        Int      @id @default(autoincrement())
  amount    Decimal  @db.Decimal(10, 2)
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Family Tree module
// ---------------------------------------------------------------------------

enum Gender {
  MALE
  FEMALE
  UNKNOWN
}

enum RelationType {
  PARENT_OF
  SPOUSE_OF
}

/// A person in the family tree.
model FamilyMember {
  id            Int      @id @default(autoincrement())
  fullName      String
  gender        Gender   @default(UNKNOWN)
  birthYear     Int?
  notes         String?
  /// True for a box the original chart left blank (an unnamed spouse or
  /// child) — surfaced in the UI as "tap to name" until someone fills it in.
  isPlaceholder Boolean  @default(false)
  /// Stable id from the source SmartArt shape, so re-running the import
  /// script updates existing rows instead of creating duplicates. Null for
  /// members added by hand from the UI.
  importKey     String?  @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  relationshipsFrom FamilyRelationship[] @relation("RelationshipFrom")
  relationshipsTo   FamilyRelationship[] @relation("RelationshipTo")
}

/// A directed edge between two family members.
///   PARENT_OF: fromMember is a parent of toMember (a child may have more
///              than one incoming PARENT_OF edge, one per parent).
///   SPOUSE_OF: fromMember and toMember are married/partnered — stored once
///              per couple; queries check both directions.
model FamilyRelationship {
  id           Int          @id @default(autoincrement())
  type         RelationType
  fromMemberId Int
  toMemberId   Int
  /// Preserves the order children/spouses were listed in, so the tree
  /// renders in the same order as the source chart.
  sortOrder    Int          @default(0)
  /// Year the couple married. Only meaningful on SPOUSE_OF edges; null when
  /// unknown, which is the case for everything the original chart imported.
  marriageYear Int?
  createdAt    DateTime     @default(now())

  fromMember FamilyMember @relation("RelationshipFrom", fields: [fromMemberId], references: [id], onDelete: Cascade)
  toMember   FamilyMember @relation("RelationshipTo", fields: [toMemberId], references: [id], onDelete: Cascade)

  @@unique([fromMemberId, toMemberId, type])
  @@index([fromMemberId])
  @@index([toMemberId])
}

// ---------------------------------------------------------------------------
// Expense Tracker module
// ---------------------------------------------------------------------------
//
// Everything the household spends that isn't groceries or fuel — those two
// have their own modules and stay there, so this ledger's monthly total is
// deliberately "everything else".
//
// One ledger doing two jobs, taken from the two apps it was modelled on:
//   * a personal ledger (Wallet) — Expense rows under ExpenseCategory, capped
//     by ExpenseBudget and totalled per month;
//   * a shared one (Splitwise) — every Expense names who paid it, and may
//     split across ExpensePerson via ExpenseShare, leaving balances that
//     Settlement rows pay off.
//
// Balances are never stored: they are what the shares and settlements add up
// to, worked out in src/lib/expenses/balances.ts. A stored balance is a second
// source of truth that drifts the first time a row is edited.

enum EntryKind {
  EXPENSE
  INCOME
}

/// How an expense divides between the people on it.
///   EQUAL  — split evenly; the paise remainder lands on whoever paid.
///   EXACT  — a typed amount each, which must sum to the expense.
///   SHARES — weighted (2 shares to 1); percentages are this by another name.
enum SplitMethod {
  EQUAL
  EXACT
  SHARES
}

/// What an entry is for: Rent, School, Medical — or, for income, Salary.
model ExpenseCategory {
  id        Int       @id @default(autoincrement())
  nameEn    String
  nameTa    String?
  /// Categories are listed for one kind or the other: you do not file a
  /// salary under Medical, and an expense sheet should not offer it.
  kind      EntryKind @default(EXPENSE)
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  expenses Expense[]
  budget   ExpenseBudget?

  @@unique([nameEn, kind])
  @@index([kind, sortOrder])
}

/// Someone who pays for things, or owes for them.
///
/// Kept apart from FamilyMember on purpose: that is a genealogy of 83 people
/// including the long dead, and a picker over it would be unusable. This is
/// the three or four people who actually share a bill.
model ExpensePerson {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  /// One of the app's accent names (blue, green, orange, ...) — how the
  /// person reads at a glance in a list of shares. Null means the default.
  colorKey  String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  paidExpenses     Expense[]
  shares           ExpenseShare[]
  settlementsPaid  Settlement[]      @relation("SettlementFrom")
  settlementsTaken Settlement[]      @relation("SettlementTo")
  tripsOn          TripParticipant[]
}

/// How it was paid — Cash, GPay, a particular card.
///
/// A label, not an account: it carries no balance, so nothing here can go out
/// of step with a bank the app cannot see.
model PaymentMethod {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  expenses Expense[]
}

/// One entry in the ledger: money out (EXPENSE) or money in (INCOME).
model Expense {
  id          Int          @id @default(autoincrement())
  kind        EntryKind    @default(EXPENSE)
  amount      Decimal      @db.Decimal(10, 2)
  spentAt     DateTime
  /// Sortable "YYYY-MM" derived from spentAt, so a month's entries are one
  /// indexed lookup — the same key GroceryList sorts by.
  monthKey    String
  categoryId  Int
  /// Who actually paid. Null when nobody has said — an entry still counts
  /// towards the month's total, it just cannot take part in a balance.
  paidById    Int?
  methodId    Int?
  note        String?
  /// Null when the entry is one person's alone; set when shares exist.
  splitMethod SplitMethod?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  category ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  paidBy   ExpensePerson?  @relation(fields: [paidById], references: [id], onDelete: SetNull)
  method   PaymentMethod?  @relation(fields: [methodId], references: [id], onDelete: SetNull)
  shares   ExpenseShare[]

  /// The trip this was logged under, if any. Cascades: a trip's expenses are
  /// meaningless once the trip itself is deleted, the same way a GroceryList
  /// deletion takes its GroceryListItem rows with it.
  tripId Int?
  trip   ExpenseTrip? @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([monthKey])
  @@index([categoryId])
  @@index([paidById])
  @@index([spentAt])
  @@index([tripId])
}

/// One person's part of a split expense. The shares of an expense always sum
/// to its amount, to the paisa — enforced when they are written.
model ExpenseShare {
  id         Int     @id @default(autoincrement())
  expenseId  Int
  personId   Int
  amount     Decimal @db.Decimal(10, 2)
  /// Weight for a SHARES split ("2 shares to 1"), kept so the split can be
  /// reopened and adjusted rather than re-derived from rupees. Null otherwise.
  shareUnits Int?

  expense Expense       @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  person  ExpensePerson @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([expenseId, personId])
  @@index([personId])
}

/// Money actually handed over to clear a debt — Splitwise's "settle up".
/// Not an expense: it moves what is already owed, it does not spend anything,
/// so it never counts towards a month's total or a budget.
model Settlement {
  id           Int      @id @default(autoincrement())
  fromPersonId Int
  toPersonId   Int
  amount       Decimal  @db.Decimal(10, 2)
  settledAt    DateTime @default(now())
  monthKey     String
  note         String?
  createdAt    DateTime @default(now())

  fromPerson ExpensePerson @relation("SettlementFrom", fields: [fromPersonId], references: [id], onDelete: Cascade)
  toPerson   ExpensePerson @relation("SettlementTo", fields: [toPersonId], references: [id], onDelete: Cascade)

  /// Set when this payment was made to settle one specific trip, so the
  /// trip's own balance can read "settled" without pulling in every other
  /// debt the same two people happen to owe each other elsewhere.
  tripId Int?
  trip   ExpenseTrip? @relation(fields: [tripId], references: [id], onDelete: SetNull)

  @@index([monthKey])
  @@index([fromPersonId])
  @@index([toPersonId])
  @@index([tripId])
}

/// A category's monthly ceiling. One amount that applies every month, the way
/// FuelBudget is one adjustable limit — a row per category per month is a lot
/// of upkeep for a number a household sets once and revisits twice a year.
model ExpenseBudget {
  id         Int      @id @default(autoincrement())
  categoryId Int      @unique
  amount     Decimal  @db.Decimal(10, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  category ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
}

/// A named pot of expenses with a fixed roster — "Goa trip", "Roommates,
/// Sep" — settled as its own self-contained unit rather than folded into
/// the household's ongoing balance.
///
/// Every expense logged under a trip defaults to an EQUAL split across the
/// whole roster (see the entry sheet), which is what makes "split the trip
/// equally at the end" true without a second, separate kind of arithmetic:
/// summing many equally-split expenses and settling once at the end gives
/// the same answer as one lump equal split of the total would, to the
/// paisa (bar rounding landing on a different line item), while staying
/// editable per expense for the one person who skipped a meal.
model ExpenseTrip {
  id        Int       @id @default(autoincrement())
  name      String
  /// Set once the trip is wound up. Only hides it from the "new expense"
  /// trip picker — the balance and history stay visible and correct either
  /// way, so closing is a tidiness step, never a lock.
  closedAt  DateTime?
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  participants TripParticipant[]
  expenses     Expense[]
  settlements  Settlement[]

  @@index([closedAt])
}

/// One person's membership on a trip's roster.
model TripParticipant {
  id       Int @id @default(autoincrement())
  tripId   Int
  personId Int

  trip   ExpenseTrip   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  person ExpensePerson @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([tripId, personId])
  @@index([personId])
}

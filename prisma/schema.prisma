// Home — a small household hub, one module per household task.
//
// ## Grocery module
// Mirrors the master data exported from "Grocery database.xlsx":
//   Grocery    -> Item.nameTa   (Tamil name)
//   Grocery.1  -> Item.nameEn   (English name)
//   (added)    -> Item.nameTl   (Tanglish — the Tamil name in Latin script)
//   Type       -> Category      (e.g. பருப்பு வகை / Dals)
//   Qty Type   -> Item.unitType (kg, g, L, ml, Rs, or blank = countable)
//   From       -> Shop          (e.g. D Mart, Balamurugan, Jio Mart)
//
// ## Petrol Card module
// FuelEntry logs one refuel (vehicle, amount, when, where); FuelBudget is a
// single adjustable monthly spending limit compared against the current
// month's FuelEntry total.
//
// ## Family Budget module
// BudgetExpense is a *rule* ("rent, ₹18,000, monthly from the 5th"), not a
// list of dates. Due dates are computed from the rule on read, so the
// calendar works arbitrarily far forward and back with no generator job.
// BudgetOccurrence is sparse — a row exists only once a human has touched
// that date (paid it, skipped it, or overridden its amount). BudgetReminder
// is the append-only log of pushes already sent, and its unique key is what
// makes the daily reminder sweep idempotent.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

/// Unit of measure for an item. Drives the +/- stepper increments in the UI.
///   G, ML  -> step 50
///   KG, L  -> step 0.5
///   RS     -> step 10
///   COUNT  -> step 1 (blank "Qty Type" in the spreadsheet)
enum UnitType {
  KG
  G
  L
  ML
  RS
  COUNT
}

enum ListStatus {
  DRAFT
  FINALIZED
  COMPLETED
}

/// "Type" column — e.g. பருப்பு வகை / Dals
model Category {
  id        Int      @id @default(autoincrement())
  nameTa    String?
  nameEn    String   @unique
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  items Item[]

  @@index([sortOrder])
}

/// "From" column — the shop an item is normally bought from.
model Shop {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  items          Item[]
  groceryItems   GroceryListItem[]
  priceHistories PriceHistory[]
}

/// A master-data grocery item.
model Item {
  id              Int      @id @default(autoincrement())
  nameTa          String
  nameEn          String
  /// "Tanglish" — the Tamil name written in Latin script
  /// (கடலை பருப்பு -> "Kadalai Paruppu"). Optional: null means nobody has
  /// supplied one yet, and the UI falls back to the Tamil name. Kept
  /// separate from nameEn because the English name is a *translation*
  /// ("Bengal gram"), not something you can read out loud at the shop.
  nameTl          String?
  unitType        UnitType @default(COUNT)
  /// Quantity pre-filled when the item is added to a list.
  defaultQty      Decimal  @default(1) @db.Decimal(10, 2)
  categoryId      Int
  /// Default shop ("From"); can be overridden per list item.
  shopId          Int?
  isActive        Boolean  @default(true)
  /// Marked in the source spreadsheet as sold in inconsistent pack sizes
  /// (soaps, pastes, shampoos, ...). Only these items expose the
  /// quantity/unit editor while shopping and on the create/edit item form.
  hasVariableUnit Boolean  @default(false)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  category       Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  shop           Shop?             @relation(fields: [shopId], references: [id], onDelete: SetNull)
  listItems      GroceryListItem[]
  priceHistories PriceHistory[]

  @@unique([nameEn, categoryId])
  @@index([nameTa])
  @@index([categoryId])
  @@index([shopId])
}

/// A monthly list, e.g. "Jul 2026".
model GroceryList {
  id          Int        @id @default(autoincrement())
  name        String
  /// Sortable month key, "YYYY-MM". Several lists can share a month as
  /// long as their names differ.
  monthKey    String
  status      ListStatus @default(DRAFT)
  finalizedAt DateTime?
  completedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  items          GroceryListItem[]
  priceHistories PriceHistory[]

  @@unique([monthKey, name])
  @@index([monthKey])
}

/// One row of a monthly list.
model GroceryListItem {
  id       Int      @id @default(autoincrement())
  listId   Int
  itemId   Int
  quantity Decimal  @db.Decimal(10, 2)
  /// Snapshot of the item's unit at the time it was added.
  unitType UnitType
  /// Shop this row must be bought from (overrides Item.shopId).
  shopId   Int?

  isPurchased      Boolean   @default(false)
  /// Price actually paid, entered while shopping.
  purchasePrice    Decimal?  @db.Decimal(10, 2)
  /// Snapshot of the previous month's price, kept for the up/down indicator.
  previousPrice    Decimal?  @db.Decimal(10, 2)
  /// Snapshot of the quantity/unit that previousPrice was paid for — needed
  /// to compare fairly when a variable-unit item's size changes between
  /// purchases (e.g. 150g this month vs. 200g last month).
  previousQuantity Decimal?  @db.Decimal(10, 2)
  previousUnitType UnitType?
  purchasedAt      DateTime?

  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  list GroceryList @relation(fields: [listId], references: [id], onDelete: Cascade)
  item Item        @relation(fields: [itemId], references: [id], onDelete: Restrict)
  shop Shop?       @relation(fields: [shopId], references: [id], onDelete: SetNull)

  @@unique([listId, itemId, shopId])
  @@index([listId, shopId])
  @@index([itemId])
}

/// Append-only record of what an item actually cost, used for
/// "cheaper / dearer than last month" comparisons.
model PriceHistory {
  id          Int      @id @default(autoincrement())
  itemId      Int
  listId      Int?
  shopId      Int?
  price       Decimal  @db.Decimal(10, 2)
  quantity    Decimal  @db.Decimal(10, 2)
  unitType    UnitType
  purchasedAt DateTime @default(now())

  item Item         @relation(fields: [itemId], references: [id], onDelete: Cascade)
  list GroceryList? @relation(fields: [listId], references: [id], onDelete: SetNull)
  shop Shop?        @relation(fields: [shopId], references: [id], onDelete: SetNull)

  @@index([itemId, purchasedAt])
  @@index([listId])
}

// ---------------------------------------------------------------------------
// Petrol Card module
// ---------------------------------------------------------------------------

enum VehicleType {
  TWO_WHEELER
  CAR
}

/// A household vehicle. Kept as real rows (rather than a fixed enum) so
/// vehicles can be added and their details edited over time.
model Vehicle {
  id                 Int         @id @default(autoincrement())
  name               String      @db.VarChar(191)
  type               VehicleType
  registrationNumber String?     @db.VarChar(32)
  insuranceRenewal   DateTime?   @db.Date
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  fuelEntries FuelEntry[]
}

/// One refuel: how much, which vehicle, when, and (if the browser allowed
/// it) where — captured automatically via the Geolocation API.
model FuelEntry {
  id          Int         @id @default(autoincrement())
  vehicleId   Int
  amount      Decimal     @db.Decimal(10, 2)
  refueledAt  DateTime
  latitude    Decimal?    @db.Decimal(9, 6)
  longitude   Decimal?    @db.Decimal(9, 6)
  /// A short human-readable area name resolved from lat/lng client-side (e.g. "Indiranagar, Bengaluru").
  locationLabel String?   @db.VarChar(191)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])

  @@index([refueledAt])
  @@index([vehicleId])
}

/// A single adjustable monthly spending limit — not one row per month, just
/// whatever's currently set, compared against the current month's spend.
model FuelBudget {
  id        Int      @id @default(autoincrement())
  amount    Decimal  @db.Decimal(10, 2)
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Family Budget module
// ---------------------------------------------------------------------------

/// How often an expense repeats. CUSTOM_MONTHS carries its own interval in
/// BudgetExpense.intervalMonths; every other value maps to a fixed number of
/// months (see intervalMonthsOf in src/lib/budget/recurrence.ts).
enum BudgetRecurrence {
  ONE_OFF
  MONTHLY
  EVERY_2_MONTHS
  QUARTERLY
  HALF_YEARLY
  YEARLY
  CUSTOM_MONTHS
}

enum BudgetOccurrenceStatus {
  PAID
  SKIPPED
}

/// UPCOMING fires `reminderLeadDays` before the due date, DUE on the day.
enum BudgetReminderKind {
  UPCOMING
  DUE
}

/// Rent, EB bill, insurance, ... Kept as rows rather than a fixed enum so the
/// household can add its own without a migration — same reasoning as Vehicle.
model BudgetCategory {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(64)
  /// Key into the icon map in src/components/budget/icons.tsx.
  iconKey   String   @default("other") @db.VarChar(32)
  /// Key into COLOR_CLASSES in the same file (blue | orange | green | red | purple | grey).
  colorKey  String   @default("blue") @db.VarChar(32)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  expenses BudgetExpense[]

  @@index([sortOrder])
}

/// A recurring (or one-off) household expense. This row is the *rule*;
/// individual due dates are derived from it and never stored up front.
model BudgetExpense {
  id             Int              @id @default(autoincrement())
  name           String           @db.VarChar(191)
  categoryId     Int
  /// Planned amount for one occurrence; overridable per occurrence.
  amount         Decimal          @db.Decimal(10, 2)
  recurrence     BudgetRecurrence
  /// Only meaningful when recurrence = CUSTOM_MONTHS; null otherwise.
  intervalMonths Int?
  /// First due date, "YYYY-MM-DD". Every later occurrence is computed as
  /// anchorDate + k * interval months — from the anchor, never by stepping
  /// off the previous occurrence — so a bill due on the 31st clamps to short
  /// months without permanently drifting to the 28th.
  anchorDate     String           @db.Char(10)
  /// Inclusive last date the rule may produce, or null for indefinitely.
  endDate        String?          @db.Char(10)
  isActive       Boolean          @default(true)

  remindersEnabled Boolean @default(true)
  /// Days before the due date the "upcoming" push fires. 0 = only on the day.
  reminderLeadDays Int     @default(2)

  notes     String?  @db.VarChar(255)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category    BudgetCategory     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  occurrences BudgetOccurrence[]
  reminders   BudgetReminder[]

  @@index([isActive, anchorDate])
  @@index([categoryId])
}

/// Sparse: a row exists only once an occurrence has been paid, skipped, or
/// given a one-off amount. Untouched occurrences are derived from the rule.
model BudgetOccurrence {
  id            Int                     @id @default(autoincrement())
  expenseId     Int
  /// "YYYY-MM-DD" — a civil date, deliberately not a DateTime. See the note
  /// on date handling in src/lib/budget/recurrence.ts.
  dueDate       String                  @db.Char(10)
  status        BudgetOccurrenceStatus?
  /// Replaces BudgetExpense.amount for this occurrence only.
  plannedAmount Decimal?                @db.Decimal(10, 2)
  /// What was actually paid — allowed to differ from the planned amount.
  paidAmount    Decimal?                @db.Decimal(10, 2)
  /// Calendar date of payment, "YYYY-MM-DD".
  paidOn        String?                 @db.Char(10)
  note          String?                 @db.VarChar(255)
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  expense BudgetExpense @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  @@unique([expenseId, dueDate])
  @@index([dueDate])
}

/// One row per reminder actually sent. The unique key IS the idempotency
/// guard — a re-run of the daily sweep hits P2002 and sends nothing.
model BudgetReminder {
  id        Int                @id @default(autoincrement())
  expenseId Int
  dueDate   String             @db.Char(10)
  kind      BudgetReminderKind
  sentAt    DateTime           @default(now())
  /// How many push subscriptions accepted the payload.
  delivered Int                @default(0)

  expense BudgetExpense @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  @@unique([expenseId, dueDate, kind])
  @@index([sentAt])
}

/// A browser push endpoint. Device-level rather than budget-specific, so
/// other modules can reuse it later.
model PushSubscription {
  id           Int      @id @default(autoincrement())
  endpoint     String   @unique @db.VarChar(512)
  p256dh       String   @db.VarChar(255)
  auth         String   @db.VarChar(255)
  userAgent    String?  @db.VarChar(255)
  label        String?  @db.VarChar(64)
  createdAt    DateTime @default(now())
  lastSeenAt   DateTime @default(now())
  /// Consecutive send failures; the row is pruned once this hits 5.
  failureCount Int      @default(0)
}

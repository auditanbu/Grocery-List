# Rebuilt inside the image — copying the host's copies would either bloat the
# build context or, worse, ship a node_modules built for a different platform.
node_modules
.next
out
build

# Regenerated by `prisma generate` inside the image (postinstall + build), so
# a client generated on the host must never leak into the build context.
src/generated

.git
.gitignore

# Never bake secrets into an image layer. Every value comes from Coolify's
# environment variables at runtime instead.
.env
.env.*
!.env.example

npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

.DS_Store
*.pem
*.tsbuildinfo

# Docs and agent config are not needed to build or run the app.
README.md
AGENTS.md
CLAUDE.md
.agents
.claude
.windsurf
skills-lock.json

# MySQL connection string.
# Locally:  mysql://root:root@localhost:3306/grocery
# Railway:  add a MySQL service (not Postgres — the schema's datasource
#           provider is `mysql`) and set this on the app service to a
#           reference to its private URL, so the traffic stays on Railway's
#           private network:
#             ${{MySQL.MYSQL_URL}}
DATABASE_URL="mysql://root:root@localhost:3306/grocery"

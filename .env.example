# MySQL connection string.
# Locally:  mysql://root:root@localhost:3306/grocery
# Coolify:  add a MySQL database resource (not Postgres — the schema's
#           datasource provider is `mysql`), then build the URL from its
#           credentials using the database's *internal* hostname, so the
#           traffic never leaves the Docker network:
#             mysql://<user>:<password>@<internal-host>:3306/<database>
DATABASE_URL="mysql://root:root@localhost:3306/grocery"

# --- Family Budget reminders (optional; the module works without them) ---

# Web Push keys. Generate once with:
#   npx web-push generate-vapid-keys
# Without these, push is simply disabled and the UI says so — the in-app
# due/overdue alerts on /budget keep working either way.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

# Shared secret the daily reminder cron sends as the `x-cron-secret` header.
# Any random string. Unset means the endpoint refuses every request (503),
# never that it is open.
CRON_SECRET=""

# Public origin of the app, e.g. https://home.example.com — used by
# `npm run cron:reminders`. The Coolify scheduled task calls localhost
# directly and does not need this.
APP_URL="http://localhost:3000"

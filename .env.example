# MySQL connection string.
# Locally:  mysql://root:root@localhost:3306/grocery
# Railway:  add a MySQL plugin (not Postgres), then copy its DATABASE_URL,
#           or reference it as ${{ MySQL.DATABASE_URL }} in the web
#           service's variables.
DATABASE_URL="mysql://root:root@localhost:3306/grocery"

# --- Family Budget reminders (optional; the module works without them) ---

# Web Push keys. Generate once with:
#   npx web-push generate-vapid-keys
# Without these, push is simply disabled and the UI says so — the in-app
# due/overdue alerts on /budget keep working either way.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

# Shared secret the daily reminder cron sends as the `x-cron-secret` header.
# Any random string. Unset means the endpoint refuses every request (503),
# never that it is open.
CRON_SECRET=""

# Public origin the cron script posts to, e.g. https://home.up.railway.app
APP_URL="http://localhost:3000"

# MySQL connection string.
# Locally:  mysql://root:root@localhost:3306/grocery
# Coolify:  add a MySQL database resource (not Postgres — the schema's
#           datasource provider is `mysql`), then build the URL from its
#           credentials using the database's *internal* hostname, so the
#           traffic never leaves the Docker network:
#             mysql://<user>:<password>@<internal-host>:3306/<database>
DATABASE_URL="mysql://root:root@localhost:3306/grocery"
